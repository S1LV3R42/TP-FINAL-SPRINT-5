<%- include('layout', { body: `
    <div class="row justify-content-center mt-3">
        <div class="col-12 col-lg-10 col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 text-center text-md-start">${title}</h4>
                </div>
                <div class="card-body p-4">
                    ${errors.length > 0 ? `
                        <div class="alert alert-danger shadow-sm">
                            <ul class="mb-0">
                                ${errors.map(e => `<li>${e.msg}</li>`).join('')}
                            </ul>
                        </div>
                    ` : ''}
                    
                    <form action="${action}" method="POST">
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Nombre Oficial</label>
                            <input type="text" name="name" class="form-control form-control-lg" value="${country.name || ''}">
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-6 mb-4">
                                <label class="form-label fw-bold text-secondary">Capitales <small class="text-muted">(separadas por coma)</small></label>
                                <input type="text" name="capital" class="form-control" value="${country.capital || ''}">
                            </div>
                            <div class="col-12 col-md-6 mb-4">
                                <label class="form-label fw-bold text-secondary">Fronteras <small class="text-muted">(ej: ARG, CHL)</small></label>
                                <input type="text" name="borders" class="form-control" value="${country.borders || ''}">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-12 col-md-4 mb-4">
                                <label class="form-label fw-bold text-secondary">Area (km2)</label>
                                <input type="text" name="area" class="form-control" value="${country.area || ''}">
                            </div>
                            <div class="col-12 col-md-4 mb-4">
                                <label class="form-label fw-bold text-secondary">Poblacion</label>
                                <input type="text" name="population" class="form-control" value="${country.population || ''}">
                            </div>
                            <div class="col-12 col-md-4 mb-4">
                                <label class="form-label fw-bold text-secondary">Indice Gini (0-100)</label>
                                <input type="text" name="gini" class="form-control" value="${country.gini ?? ''}">
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label fw-bold text-secondary">Zonas Horarias <small class="text-muted">(separadas por coma)</small></label>
                            <input type="text" name="timezones" class="form-control" value="${country.timezones || ''}">
                        </div>
                        <div class="mb-5">
                            <label class="form-label fw-bold text-secondary">Creador</label>
                            <input type="text" name="creador" class="form-control" value="${country.creador || ''}">
                        </div>
                        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mt-4 pt-3 border-top">
                            <a href="/paises" class="btn btn-outline-secondary px-4 py-2">Cancelar</a>
                            <button type="submit" class="btn btn-success px-4 py-2 fw-bold">Guardar Pais</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
`}) %>