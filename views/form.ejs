<%- include('layout', { body: `
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">${title}</h4>
                </div>
                <div class="card-body">
                    ${errors.length > 0 ? `
                        <div class="alert alert-danger">
                            <ul class="mb-0">
                                ${errors.map(e => `<li>${e.msg}</li>`).join('')}
                            </ul>
                        </div>
                    ` : ''}
                    
                    <form action="${action}" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Nombre Oficial</label>
                            <input type="text" name="name" class="form-control" value="${country.name || ''}" required minlength="3" maxlength="90">
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Capitales (separadas por coma)</label>
                                <input type="text" name="capital" class="form-control" value="${country.capital || ''}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">Fronteras (ej: ARG, CHL)</label>
                                <input type="text" name="borders" class="form-control" value="${country.borders || ''}">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Area</label>
                                <input type="number" step="0.01" min="0" name="area" class="form-control" value="${country.area || ''}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Poblacion</label>
                                <input type="number" min="0" name="population" class="form-control" value="${country.population || ''}" required>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label fw-bold">Indice Gini (0-100)</label>
                                <input type="number" step="0.1" min="0" max="100" name="gini" class="form-control" value="${country.gini !== null ? country.gini : ''}">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Zonas Horarias (separadas por coma)</label>
                            <input type="text" name="timezones" class="form-control" value="${country.timezones || ''}">
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <a href="/paises" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-success">Guardar Pais</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
`}) %>